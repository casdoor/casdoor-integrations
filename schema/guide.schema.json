{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/casdoor/casdoor-integrations/schema/guide.schema.json",
  "title": "Setup guide (guide.json)",
  "description": "Text fields may use `code` and **bold**, and {{variables}}. List only the steps on the other side: for an app integration, the first step (registering the app in Casdoor) is generated from application.json; for a provider template, the last steps (adding the provider in Casdoor and to an application) are generated from provider.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkedOn", "title", "headline", "summary", "steps", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "checkedOn": {
      "description": "Month the other side's settings were last checked against its documentation (YYYY-MM).",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "title": { "description": "Page title for search results.", "type": "string", "minLength": 1, "maxLength": 70 },
    "headline": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "redirectNote": {
      "description": "App integrations only: shown under the redirect URLs in the generated Casdoor step.",
      "type": "string",
      "minLength": 1
    },
    "groupExample": {
      "description": "App integrations only: example group names in the generated Casdoor step, e.g. `grafana-admins` and `grafana-editors`. Set it when the app reads groups.",
      "type": "string",
      "pattern": "`[^`]+`"
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "tips": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "description": "The other side's own documentation the settings come from.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "format": "uri" }
        }
      }
    },
    "docsUrl": { "description": "Matching page in the Casdoor documentation.", "type": "string", "format": "uri" }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lang", "content"],
          "properties": {
            "lang": { "type": "string", "minLength": 1 },
            "content": { "type": "string", "minLength": 1 }
          }
        },
        "fields": {
          "description": "Form fields to fill in the app's admin UI.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
