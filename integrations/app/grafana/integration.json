{
  "$schema": "../../../schema/integration.schema.json",
  "id": "grafana",
  "type": "app",
  "version": "1.0.0",
  "casdoorVersion": ">=4.18.0",
  "name": {
    "en": "Grafana"
  },
  "description": {
    "en": "Set up Grafana single sign-on with Casdoor over OpenID Connect: Generic OAuth settings, PKCE, and Grafana roles mapped from Casdoor groups."
  },
  "author": "casdoor",
  "license": "Apache-2.0",
  "logo": "logo.svg",
  "homepage": "https://grafana.com",
  "categories": [
    "DevOps & infrastructure"
  ],
  "variables": [
    {
      "name": "appUrl",
      "label": {
        "en": "Grafana URL"
      },
      "description": {
        "en": "The address people open Grafana at, without a trailing slash."
      },
      "type": "url",
      "required": true,
      "example": "https://grafana.example.com"
    }
  ]
}
