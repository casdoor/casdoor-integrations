{
  "$schema": "../../../schema/integration.schema.json",
  "id": "open-webui",
  "type": "app",
  "version": "1.0.0",
  "casdoorVersion": ">=4.18.0",
  "name": {
    "en": "Open WebUI"
  },
  "description": {
    "en": "Set up Open WebUI single sign-on with Casdoor over OpenID Connect: OAuth environment variables, sign-up, and group sync from Casdoor groups."
  },
  "author": "casdoor",
  "license": "Apache-2.0",
  "homepage": "https://openwebui.com",
  "categories": [
    "AI"
  ],
  "variables": [
    {
      "name": "appUrl",
      "label": {
        "en": "Open WebUI URL"
      },
      "description": {
        "en": "The address people open Open WebUI at, without a trailing slash."
      },
      "type": "url",
      "required": true,
      "example": "https://chat.example.com"
    }
  ]
}
