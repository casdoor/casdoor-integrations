{
  "$schema": "../../../schema/integration.schema.json",
  "id": "gitlab",
  "type": "app",
  "version": "1.0.0",
  "casdoorVersion": ">=4.18.0",
  "name": {
    "en": "GitLab"
  },
  "description": {
    "en": "Configure self-managed GitLab to sign users in with Casdoor over OpenID Connect: gitlab.rb provider settings, account creation and group-based admins."
  },
  "author": "casdoor",
  "license": "Apache-2.0",
  "logo": "logo.svg",
  "homepage": "https://about.gitlab.com",
  "tags": [
    "OIDC",
    "PKCE",
    "Group mapping"
  ],
  "categories": [
    "DevOps & infrastructure"
  ],
  "variables": [
    {
      "name": "appUrl",
      "label": {
        "en": "GitLab URL"
      },
      "description": {
        "en": "The address people open GitLab at, without a trailing slash."
      },
      "type": "url",
      "required": true,
      "example": "https://gitlab.example.com"
    }
  ]
}
