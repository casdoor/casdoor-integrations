{
  "$schema": "../../../schema/integration.schema.json",
  "id": "proxmox",
  "type": "app",
  "version": "1.0.0",
  "casdoorVersion": ">=4.18.0",
  "name": {
    "en": "Proxmox VE"
  },
  "description": {
    "en": "Add Casdoor to Proxmox VE as an OpenID Connect realm: the pveum command, redirect URL, usernames, groups and permissions."
  },
  "author": "casdoor",
  "license": "Apache-2.0",
  "logo": "logo.svg",
  "homepage": "https://www.proxmox.com",
  "categories": [
    "DevOps & infrastructure"
  ],
  "variables": [
    {
      "name": "appUrl",
      "label": {
        "en": "Proxmox VE URL"
      },
      "description": {
        "en": "The address people open Proxmox VE at, without a trailing slash."
      },
      "type": "url",
      "required": true,
      "example": "https://pve.example.com:8006"
    }
  ]
}
