{
  "$schema": "../../../schema/integration.schema.json",
  "id": "immich",
  "type": "app",
  "version": "1.0.0",
  "casdoorVersion": ">=4.18.0",
  "name": {
    "en": "Immich"
  },
  "description": {
    "en": "Let people sign in to Immich with Casdoor: OAuth settings in the Immich admin, the web and mobile redirect URIs, and storage label mapping."
  },
  "author": "casdoor",
  "license": "Apache-2.0",
  "logo": "logo.svg",
  "homepage": "https://immich.app",
  "tags": [
    "OIDC",
    "Mobile apps"
  ],
  "categories": [
    "Productivity"
  ],
  "variables": [
    {
      "name": "appUrl",
      "label": {
        "en": "Immich URL"
      },
      "description": {
        "en": "The address people open Immich at, without a trailing slash."
      },
      "type": "url",
      "required": true,
      "example": "https://photos.example.com"
    }
  ]
}
