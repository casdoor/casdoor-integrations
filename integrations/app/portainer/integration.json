{
  "$schema": "../../../schema/integration.schema.json",
  "id": "portainer",
  "type": "app",
  "version": "1.0.0",
  "casdoorVersion": ">=4.18.0",
  "name": {
    "en": "Portainer"
  },
  "description": {
    "en": "Set up Portainer single sign-on with Casdoor using Portainer's custom OAuth provider: endpoints, user identifier, scopes and automatic user creation."
  },
  "author": "casdoor",
  "license": "Apache-2.0",
  "logo": "logo.svg",
  "homepage": "https://www.portainer.io",
  "tags": [
    "OAuth 2.0",
    "Auto provisioning"
  ],
  "categories": [
    "DevOps & infrastructure"
  ],
  "variables": [
    {
      "name": "appUrl",
      "label": {
        "en": "Portainer URL"
      },
      "description": {
        "en": "The address people open Portainer at, without a trailing slash."
      },
      "type": "url",
      "required": true,
      "example": "https://portainer.example.com"
    }
  ]
}
