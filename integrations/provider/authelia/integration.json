{
  "$schema": "../../../schema/integration.schema.json",
  "id": "authelia",
  "type": "provider",
  "version": "1.0.0",
  "casdoorVersion": ">=4.18.0",
  "name": {
    "en": "Authelia"
  },
  "description": {
    "en": "Let people sign in to Casdoor through Authelia over OpenID Connect: the provider settings, and the client to add to Authelia's configuration."
  },
  "author": "casdoor",
  "license": "Apache-2.0",
  "logo": "logo.svg",
  "homepage": "https://www.authelia.com",
  "categories": [
    "Identity providers"
  ],
  "variables": [
    {
      "name": "autheliaUrl",
      "label": {
        "en": "Authelia URL"
      },
      "description": {
        "en": "The address of your Authelia portal, without a trailing slash."
      },
      "type": "url",
      "required": true,
      "example": "https://authelia.example.com"
    }
  ]
}
