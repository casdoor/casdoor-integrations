{
  "$schema": "../../../schema/provider/provider.schema.json",
  "category": "OAuth",
  "type": "Custom",
  "displayName": "超星学习通",
  "customAuthUrl": "https://auth.chaoxing.com/connect/oauth2/authorize?appid={clientId}&redirect_uri={redirectUri}&response_type=code&scope={scope}&state={state}",
  "customTokenUrl": "https://auth.chaoxing.com/sns/oauth2/access_token/v1.0?appid={clientId}&secret={clientSecret}&code={code}&grant_type=authorization_code",
  "customUserInfoUrl": "https://v1.chaoxing.com/backSchool/user/getUserByTokenFormMooc?access_token={access_token}&openid={openid}&expires_time={expires_time}&state={state}",
  "scopes": "snsapi_base",
  "userMapping": {
    "id": "userInfo.uid",
    "displayName": "userInfo.displayName"
  }
}
