{
  "manifest": {
    "id": "split",
    "type": "theme",
    "version": "1.0.1",
    "casdoorVersion": ">=4.18.0",
    "name": {
      "en": "Split"
    },
    "description": {
      "en": "A brand panel in your color with your own headline next to the sign-in form. It sets the side panel HTML, which organization admins can install on Casdoor 4.20.0 and later; before that only a global admin can."
    },
    "author": "casdoor",
    "license": "Apache-2.0",
    "tags": [
      "Light",
      "Side panel"
    ],
    "categories": [
      "Sign-in themes"
    ],
    "screenshots": [
      "screenshot.png"
    ],
    "variables": [
      {
        "name": "brandColor",
        "label": {
          "en": "Brand color"
        },
        "description": {
          "en": "The panel and the buttons."
        },
        "type": "color",
        "required": true,
        "example": "#2563eb"
      },
      {
        "name": "headline",
        "label": {
          "en": "Headline"
        },
        "type": "string",
        "required": true,
        "example": "Welcome back"
      },
      {
        "name": "tagline",
        "label": {
          "en": "Tagline"
        },
        "type": "string",
        "required": false,
        "example": "Sign in to continue to Acme."
      }
    ]
  },
  "files": {
    "theme.json": {
      "themeData": {
        "themeType": "default",
        "colorPrimary": "{{brandColor}}",
        "borderRadius": 10,
        "isCompact": false,
        "isEnabled": true
      },
      "formOffset": 4,
      "formSideHtml": "<div style=\"box-sizing: border-box; height: 100%; min-height: 480px; display: flex; flex-direction: column; justify-content: flex-end; padding: 40px; color: #ffffff; background: linear-gradient(160deg, {{brandColor}} 0%, #0f172a 100%);\"><p style=\"margin: 0; font-size: 28px; line-height: 1.25; font-weight: 600;\">{{headline}}</p><p style=\"margin: 12px 0 0; font-size: 15px; line-height: 1.5; opacity: 0.8;\">{{tagline}}</p></div>"
    }
  }
}
