  },
  "author": "casdoor",
  "license": "Apache-2.0",
  "tags": [
    "Light",
    "Material",
    "CSS only"
  ],
  "categories": [
    "Sign-in themes"
  ],
  "screenshots": [
    "screenshot.png"
  ],
  "variables": [
    {
      "name": "accentColor",
      "label": {
        "en": "Accent color"
      },
      "description": {
        "en": "Buttons, links, the selected tab and focused fields."
      },
      "type": "color",
      "required": true,
      "example": "#0b57d0"
    }
  ]
